/*
 * Lily58 Keymap - 3 layers
 * Layer 0: Default QWERTY
 * Layer 1: Lower (symbols / nav)
 * Layer 2: Raise (RGB / media)
 *
 * NOTE: This was reconstructed from your keymap SVG export.
 * The lower layer (layer 1) is a reasonable default since it was
 * cut off in the SVG. Adjust as needed — or use ZMK Studio over
 * USB on the dongle to remap keys live without reflashing.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ---------------------------------------------------------------
         * LAYER 0 — Default QWERTY
         * ----------------------------------------------------------------
         * ,-----.-----.-----.-----.-----.-----.     ,-----.-----.-----.-----.-----.-----.
         * | ESC |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  |  ` |
         * |-----+-----+-----+-----+-----+-----|     |-----+-----+-----+-----+-----+-----|
         * | TAB |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |  - |
         * |-----+-----+-----+-----+-----+-----|     |-----+-----+-----+-----+-----+-----|
         * |CAPS |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |  ' |
         * |-----+-----+-----+-----+-----+-----+-----.-----.-----+-----+-----+-----+-----|
         * |SHFT |  Z  |  X  |  C  |  V  |  B  |  [  |  ]  |  N  |  M  |  ,  |  .  |  / |SHFT|
         * `-----.-----.-----+-----+-----+-----+-----.-----.-----+-----+-----+-----'-----.
         *                   | GUI | ALT | LWR |CTRL |SPC  | RSE | ALT | GUI |
         *                   `-----'-----'-----'-----'-----'-----'-----'-----'
         */
        default_layer {
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                       &kp N6  &kp N7   &kp N8    &kp N9   &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                        &kp Y   &kp U    &kp I     &kp O    &kp P    &kp MINUS
&kp CAPS  &kp A  &kp S  &kp D    &kp F    &kp G                        &kp H   &kp J    &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp LBKT   &kp RBKT  &kp N   &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                         &kp LGUI &kp LALT &mo 1  &kp LCTRL  &kp SPACE &mo 2   &kp RALT &kp RGUI
            >;
        };

        /* ---------------------------------------------------------------
         * LAYER 1 — Lower (Symbols / Navigation)
         * NOTE: Adjust this layer to match your original if it differs.
         * ----------------------------------------------------------------
         * ,-----.-----.-----.-----.-----.-----.     ,-----.-----.-----.-----.-----.-----.
         * |     | F1  | F2  | F3  | F4  | F5  |     | F6  | F7  | F8  | F9  | F10 |     |
         * |-----+-----+-----+-----+-----+-----|     |-----+-----+-----+-----+-----+-----|
         * |     |  !  |  @  |  #  |  $  |  %  |     |  ^  |  &  |  *  |  (  |  )  |     |
         * |-----+-----+-----+-----+-----+-----|     |-----+-----+-----+-----+-----+-----|
         * |     |     |     |     |     |     |     |  -  |  =  |  [  |  ]  |  \  |  `  |
         * |-----+-----+-----+-----+-----+-----+-----.-----.-----+-----+-----+-----+-----|
         * |     |     |     |     |     |     |     |      |  _  |  +  |  {  |  }  |  |  |  ~  |
         * `-----.-----.-----+-----+-----+-----+-----.-----.-----+-----+-----+-----'-----.
         *                   |     |     |     |     |      |     |     |     |
         *                   `-----'-----'-----'-----'------'-----'-----'-----'
         */
        lower_layer {
            bindings = <
&trans  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &trans
&trans  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                    &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &trans
&trans  &trans    &trans    &trans    &trans    &trans                       &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &trans    &trans    &trans    &trans    &trans    &trans    &trans   &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                            &trans    &trans    &trans    &trans    &trans   &trans    &trans    &trans
            >;
        };

        /* ---------------------------------------------------------------
         * LAYER 2 — Raise (RGB / Media)
         * Reconstructed from SVG — matches your original raise layer.
         * ----------------------------------------------------------------
         * ,-----.-----.-----.-----.-----.-----.     ,-----.-----.-----.-----.-----.-----.
         * |     |     |     |     |     |     |     |     |     |     |     |     |     |
         * |-----+-----+-----+-----+-----+-----|     |-----+-----+-----+-----+-----+-----|
         * |EPTOG|R_HUD|R_HUI|R_SAD|R_SAI|R_EFF|     |     |     |     |     |     |     |
         * |-----+-----+-----+-----+-----+-----|     |-----+-----+-----+-----+-----+-----|
         * |     |R_BRD|R_BRI|     |     |     |     |     |     |     |     |     |     |
         * |-----+-----+-----+-----+-----+-----+-----.-----.-----+-----+-----+-----+-----|
         * |     |     |     |     |     |     |     |     |     |     |     |     |     |     |
         * `-----.-----.-----+-----+-----+-----+-----.-----.-----+-----+-----+-----'-----.
         *                   |     |     |     |     |      |     |     |     |
         *                   `-----'-----'-----'-----'------'-----'-----'-----'
         */
        raise_layer {
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans                       &trans &trans &trans &trans &trans &trans
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF  &trans &trans &trans &trans &trans &trans
&trans        &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans  &trans        &trans                       &trans &trans &trans &trans &trans &trans
&trans        &trans        &trans        &trans        &trans        &trans  &trans    &trans     &trans &trans &trans &trans &trans &trans
                                          &trans        &trans        &trans  &trans    &trans     &trans &trans &trans
            >;
        };
    };
};

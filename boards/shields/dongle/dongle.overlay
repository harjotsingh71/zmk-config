/*
 * Lily58 Dongle — Hardware Overlay
 *
 * Defines:
 *   - Mock kscan (no physical keys on the dongle)
 *   - SSD1306 128x64 OLED over I2C
 *
 * WIRING (solder your SSD1306 to these pins on the ProMicro NRF52840):
 *   SSD1306 VCC  →  VCC (3.3V)
 *   SSD1306 GND  →  GND
 *   SSD1306 SDA  →  SDA pin (D2)
 *   SSD1306 SCL  →  SCL pin (D3)
 *
 * If your display doesn't show up, the most likely cause is the I2C pin
 * numbers below not matching your specific board's pin mapping.
 * Check your ProMicro NRF52840 pinout and adjust NRF_PSEL values.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/*
 * Display (SSD1306) is not wired yet.
 * When ready to add the display, uncomment the pinctrl and i2c0 blocks,
 * and add zephyr,display = &oled back to the chosen node.
 * Wiring: VCC→VCC, GND→GND, SDA→pad 017, SCL→pad 020
 */

/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    /*
     * Mock kscan — required by ZMK to compile, but fires no events.
     * All key input comes from the two BLE peripheral halves.
     */
    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        events = <0>;
    };
};

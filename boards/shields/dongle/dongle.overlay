/*
 * Lily58 Dongle — Hardware Overlay
 */

/* Import the official Lily58 hardware definition (matrix and physical layout) */
#include <boards/shields/lily58/lily58.dtsi>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        
        /* * UNCOMMENT THE LINE BELOW WHEN YOUR DISPLAY IS SOLDERED 
         */
        // zephyr,display = &oled;
    };

    /* Define the mock scanner with the correct Lily58 matrix dimensions */
    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <6>;
        rows = <5>;
        events = <0>;
    };
};

/* Tell the official Lily58 layout to use our mock scanner so ZMK Studio is happy */
&default_layout {
    kscan = <&mock_kscan>;
};

